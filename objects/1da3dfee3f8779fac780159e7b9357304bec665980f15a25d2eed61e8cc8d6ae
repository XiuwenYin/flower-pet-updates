}
let lastCap = '';
function caption(lifes) {
  const d = new Date(day); d.setDate(d.getDate() - plan.dayIdx + Math.floor(dayT));
  const wk = '一二三四五六日'[Math.floor(dayT) % 7];
  const names = [plan.focal, ...plan.second].map(sp => SPECIES[sp].name);
  const extra = [...plan.line, ...plan.fill].map(k => SPRAYS[k]);
  const T = `${d.getMonth() + 1}月${d.getDate()}日 周${wk}` + (plan.hol ? ` · ${plan.hol.name}` : ` · 这束花插的第${Math.floor(dayT) + 1}天`);
  const Pp = (plan.hol ? `${plan.hol.name}花束` : `${plan.q.name}花束`) + `：主花${names[0]}` + (names.length > 1 ? `，配${names.slice(1).join('、')}` : '') +
    (extra.length ? `，${[...new Set(extra)].join('、')}` : '') + `。花瓶：${(VASES[plan.vase] || FEST_VASES[plan.vase])}；插法：${STYLE_NAME[plan.style]}。` +
    (plan.hol ? '节日当天换上专门的花束。' : '每周一插一束新花、换一只花瓶，这一周里每天开一点，谢掉的那枝换一枝别的花补上。');
  if (T + Pp !== lastCap) { lastCap = T + Pp; document.getElementById('capT').textContent = T; document.getElementById('capP').textContent = Pp; }
}

function layout() {
