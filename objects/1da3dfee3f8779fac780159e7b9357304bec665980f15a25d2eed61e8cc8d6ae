const iso = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
// 节日花束用什么瓶：都挑最精致的；朴素的器皿只在它本身就是节日寓意的一部分时才用（中秋的竹筒取"高洁"、教师节的青瓷取书卷气）
const HV = {
  love: ['vase_crystal', 'vase_cwide'],         // 情人节、520：切面水晶瓶或宽口水晶瓶
  qixi: ['vase_d', 'vase_crystal', 'vase_cwide'],             // 七夕：青花瓶更有中国味
  mother: ['vase_crystal', 'vase_pink', 'vase_cwide'],        // 妇女节、母亲节：水晶或淡粉玻璃，温柔
  teacher: ['vase', 'vase_d'],                  // 教师节：青瓷、青花，书卷气
  xmas: ['vase_crystal', 'vase_brass', 'vase_cwide'],         // 圣诞：水晶或黄铜，暖光
  spring: ['vase_d', 'vase_brass', 'vase_ice_a'],  // 春节：青花瓶、黄铜、粉青冰裂纹，喜庆传统
  moon: ['vase', 'vase_bamboo', 'vase_ice_a'],     // 中秋：青瓷、竹筒、粉青冰裂纹
};
function holidayOf(d) {
  const s = iso(d), md = s.slice(5);
  const H = (name, r, v) => ({ name, r: HOLI[r], vases: HV[v || r] });
  if (md === '02-14') return H('情人节', 'love');
  if (md === '05-20') return H('520', 'love');
  if (md === '03-08') return H('妇女节', 'mother');
  if (d.getMonth() === 4 && d.getDay() === 0 && d.getDate() > 7 && d.getDate() <= 14) return H('母亲节', 'mother');
  if (md === '09-10') return H('教师节', 'teacher');
  if (md === '12-25') return H('圣诞节', 'xmas');
  const L = lunarOf(d);
  if (L && !L.leap) {
    if (L.m === 1 && L.d === 1) return H('春节', 'spring');
    if (L.m === 7 && L.d === 7) return H('七夕', 'love', 'qixi');
    if (L.m === 8 && L.d === 15) return H('中秋', 'moon');
