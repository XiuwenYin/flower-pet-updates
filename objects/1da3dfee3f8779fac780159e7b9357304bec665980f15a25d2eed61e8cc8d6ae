addEventListener('resize', layout);
// 长按桌面上积着花瓣的那一片，刮一阵风把落地的花瓣吹走
const HOLD_MS = 650; let hold = null, lastT = 0;
const onTable = (x, y) => V && Math.abs(y - V.by) < 34 * S && Math.abs(x - V.cx) < V.w * .75 + 40 * S;
addEventListener('pointerdown', e => {
  if (e.target.closest?.('button,input,.ui')) return;
  // 长按谢了的花 → 换一枝新的；长按桌上 → 吹走花瓣
