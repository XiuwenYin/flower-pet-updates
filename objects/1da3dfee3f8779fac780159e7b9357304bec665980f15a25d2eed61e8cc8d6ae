}
const themeBtn = document.getElementById('theme');
function applyTheme() { document.body.dataset.t = theme; themeBtn.textContent = theme === 'dark' ? '换浅色壁纸' : '换深色壁纸'; }
themeBtn.onclick = () => { theme = theme === 'dark' ? 'light' : 'dark'; applyTheme(); };
const weekBtn = document.getElementById('week');
weekBtn.onclick = () => { loadSweep(); loadCuts(); weekPlay = !weekPlay; weekStart = performance.now() / 1000; weekBtn.classList.toggle('on', weekPlay); weekBtn.textContent = weekPlay ? '停在今天' : '快放这一周'; };
const parse = s => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };
document.getElementById('date').onchange = e => e.target.value && setDay(parse(e.target.value));
document.querySelectorAll('[data-d]').forEach(b => b.onclick = () => {
  const now = new Date(), d = b.dataset.d;
  if (d === 'today') return setDay(new Date(now.getFullYear(), now.getMonth(), now.getDate()));
  let y = now.getFullYear(), [m, dd] = d.split('-').map(Number);
  if (d === '05-10') { const f = new Date(y, 4, 1); dd = 1 + (7 - f.getDay()) % 7 + 7; } // 母亲节：五月第二个周日
