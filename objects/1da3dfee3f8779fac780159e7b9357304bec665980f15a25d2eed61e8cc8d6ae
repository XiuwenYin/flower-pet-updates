}
// 省电：平时花只是慢慢晃，每秒 12 帧就够；有东西在动（花瓣飘落、刮风、长按、新花苞长出、快放）才提到 30 帧。
// 用电池时再降一档（8 / 24）；锁屏、睡眠时完全不画。帧太慢的电脑自动降低渲染分辨率（记在本机）。
let lastDraw = 0, animBusy = false, power = { battery: false, paused: false }, RS = 1, slowMs = 0;
try { RS = +localStorage.getItem('flowerRS') || 1; } catch (e) { }
DK?.onPower?.(p => { const was = power.paused; power = { ...power, ...p }; if (was && !power.paused) requestAnimationFrame(frame); });
function wantFps(t) {
