  S = DESK ? +(P.get('s') || Math.min(1.2, Math.max(.65, Math.min(screen.width / 1440, screen.height / 900)))) : Math.min(1.2, Math.max(.65, Math.min(W / 1440, H / 900)));
  cv.width = W * DPR; cv.height = H * DPR; scn.width = W * DPR; scn.height = H * DPR;
  for (const k in A.sp) if (A.sp[k]) A.sp[k].S = 0;
