    const hr = (dayT % 1) * 24, [, br, sa, warm, cool] = lightAt(hr);
    g.save(); g.setTransform(1, 0, 0, 1, 0, 0); g.globalCompositeOperation = 'source-atop';
    if (warm > 0) { g.fillStyle = `rgba(255,170,95,${warm * .55})`; g.fillRect(0, 0, scn.width, scn.height); }
    if (cool > 0) { g.fillStyle = `rgba(130,160,215,${cool * .6})`; g.fillRect(0, 0, scn.width, scn.height); }
    g.restore();
    // 花束后面一层很淡的环境光，让花和深色背景之间有过渡，不会像剪纸一样跳出来
    const Hc = V.oy - Math.max(...stems.map(s => s.L)) * .45, R = Math.max(...stems.map(s => s.L)) * 1.1;
    const amb = mg.createRadialGradient(V.cx * DPR, Hc * DPR, 0, V.cx * DPR, Hc * DPR, R * DPR);
    const a0 = DESK ? 0 : (theme === 'dark' ? .07 : .12) * br;   // 桌面上背后是真壁纸，不加这层光
    amb.addColorStop(0, `rgba(${Math.round(240 + warm * 15)},${Math.round(232 - cool * 10)},${Math.round(220 + cool * 30 - warm * 40)},${a0})`); amb.addColorStop(1, 'rgba(240,232,220,0)');
    mg.fillStyle = amb; mg.fillRect(0, 0, cv.width, cv.height);
    // 整体略降对比；亮度、饱和度随钟点
    mg.filter = `contrast(.9) brightness(${br.toFixed(3)}) saturate(${sa.toFixed(3)})`;
    mg.drawImage(scn, 0, 0); mg.filter = 'none';
    caption(lifes);
  }
  // 太慢的电脑：一帧平均超过 22 毫秒就把渲染分辨率降一档（100% → 75% → 60%）
  slowMs = slowMs * .95 + (performance.now() - t0) * .05;
  if (slowMs > 22 && RS > .6 && DPR > 1) { RS = RS > .8 ? .75 : .6; slowMs = 0; try { localStorage.setItem('flowerRS', RS); } catch (e) { } layout(); }
