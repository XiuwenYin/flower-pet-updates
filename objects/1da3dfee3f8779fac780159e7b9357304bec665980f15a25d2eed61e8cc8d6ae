      g.drawImage(V.base.c, V.base.x, V.base.y, V.base.c.width / Q, V.base.c.height / Q);
      stems.forEach((s, j) => drawStem(s, lifes[j], t, 'head'));
    } else if (V.glass) {
      // 花茎素材最短只能缩到一半，短枝会伸过瓶口往下戳；瓶口以下一律裁掉，瓶里那段由水下茎画
      g.save(); g.beginPath(); g.rect(0, 0, W, V.oy + V.ory * .8); g.clip();
