const VASES = { vase_glass: '透明玻璃瓶', vase_d: '青花瓶', vase_crystal: '切面水晶瓶', vase_enamel: '搪瓷水壶', vase_pink: '淡粉玻璃瓶',
  vase_c: '粗陶罐', vase_cyl: '直筒玻璃杯', vase_brass: '黄铜壶', vase_jar: '玻璃储物罐', vase: '青瓷瓶', vase_bubble: '气泡玻璃瓶',
  vase_f: '琥珀釉瓶', vase_trumpet: '喇叭口玻璃瓶', vase_bamboo: '竹筒', vase_green: '绿玻璃瓶' };
// 只在节日用的精致花器，不进每周轮换
const FEST_VASES = { vase_cwide: '宽口水晶瓶', vase_ice_a: '粉青冰裂纹瓶', vase_ice_b: '米黄冰裂纹瓶', vase_cbowl: '切面水晶碗' };  // 水晶碗试过不好看，没排进任何节日，只能 ?vase= 预览
// 每只瓶插多少、怎么插：cap 是枝数系数（窄口、小杯插不下几枝），styles 是适合它的插法，h 是高度系数
const VPROF = {
  vase_cyl: { cap: .3, styles: ['sparse'] },                 // 窄直筒杯：三四枝，高挑疏朗
  vase_green: { cap: .35, styles: ['sparse'] },              // 细颈瓶：两三枝
  vase_bubble: { cap: .45, styles: ['sparse', 'asym'] },     // 小口卵形瓶：几枝随手一插
  vase_bamboo: { cap: .75, styles: ['tall', 'dome'] },
  vase_pink: { cap: .7, styles: ['dome'], h: .9 },           // 矮圆瓶：一小团圆球
  vase_crystal: { cap: 1.1, styles: ['dome', 'tall'] },      // 经典水晶瓶：饱满端正
  vase_trumpet: { cap: .95, styles: ['wild', 'asym'], h: .85 }, // 喇叭口：低而向四周散开
  vase_jar: { cap: 1.15, styles: ['wild', 'dome'], h: .9 },  // 玻璃罐：随手插满的一大把
  vase_c: { cap: 1.2, styles: ['wild', 'dome'] },
  vase_enamel: { cap: 1, styles: ['wild', 'asym'] },
  vase_cbowl: { cap: 1.3, styles: ['dome'], h: .8 },        // 宽口水晶碗：低矮饱满的一大团
  vase_cwide: { cap: 1.3, styles: ['dome'] },                // 宽口水晶瓶：口大能插满
  vase_ice_a: { cap: 1.1, styles: ['dome', 'asym'] },        // 冰裂纹瓷瓶：传统节日用
  vase_ice_b: { cap: 1.1, styles: ['dome', 'asym'] },        // 米黄那只裂纹太粗，像真裂了，没排进任何节日
};
const prof = v => VPROF[v] || { cap: 1 };

/* ── 配方：季度和节日 ── */
// 每季一个花材池：每周从池子里抽 1 种主花 + 2 种配花 + 1 种线条花 + 1～2 种填充花，相邻两周的主花不重复
const QUARTERS = [
  { name: '冬末初春', focal: ['ranun', 'tulip', 'hell', 'camel', 'anem', 'rose'], second: ['narc', 'tulip', 'ranun', 'frees', 'hyac', 'anem', 'carn', 'lisi'],
    line: ['line_willow', 'line_snap'], fill: ['fill_spiraea', 'fill_lace'], foliage: ['euca1', 'euca2'] },
  { name: '春', focal: ['peony', 'rose', 'ranun', 'calla', 'iris'], second: ['rose', 'daisy', 'frees', 'lisi', 'carn', 'tulip', 'iris', 'cosmos'],
    line: ['line_snap', 'line_delph'], fill: ['fill_lace', 'fill_chamo'], foliage: ['euca1', 'euca2'] },
  { name: '夏', focal: ['hydr', 'sun', 'lily', 'lisi', 'dahl'], second: ['sun', 'lisi', 'cosmos', 'daisy', 'rose', 'carn', 'calla'],
    line: ['line_delph', 'line_grass'], fill: ['fill_chamo', 'fill_lace'], foliage: ['euca1', 'euca2'] },
  { name: '秋冬', focal: ['champ', 'dahl', 'carn', 'rose', 'camel', 'hell'], second: ['carn', 'pong', 'champ', 'lisi', 'cosmos', 'anem', 'dahl'],
    line: ['line_grass', 'line_willow'], fill: ['fill_spray', 'fill_spiraea'], foliage: ['euca1', 'euca2'] },
];
// 这一周的配方：池子按"年份+季度"洗一次牌，再按周号轮着取，所以一季里每周都不一样、相邻两周主花必不同
// 洗牌：mulberry32 伪随机数 + Fisher-Yates，种子由几个整数混出来
function shuffled(arr, ...k) {
  let a = 0x6d2b79f5; for (const v of k) a = fmix(a ^ Math.imul(v | 0, 0x9e3779b1)) + 0x632be5ab | 0;
  const rnd = () => { a = a + 0x6d2b79f5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
  const out = arr.slice();
  for (let i = out.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [out[i], out[j]] = [out[j], out[i]]; }
  return out;
}
const hq = (...k) => { let h = 0x5bd1e995; for (const v of k) h = fmix(h ^ Math.imul(v | 0, 0x9e3779b1)); return (h >>>  0) / 4294967296; };
// 每台机器自己的随机种子：第一次打开时随机生成并记住。所有人在同一天看到的花束、花瓶顺序、插法都不一样，
// 但同一台机器上是连贯的（今天的花明天接着开）。?user= 可以指定种子预览别人的花
const USER = (() => {
  if (P.has('user')) return +P.get('user') | 0;
  try {
    let v = localStorage.getItem('flowerSeed');
    if (!v) { v = String(crypto.getRandomValues(new Uint32Array(1))[0]); localStorage.setItem('flowerSeed', v); }
    return +v | 0;
  } catch (e) { return (Math.random() * 4294967296) | 0; }
})();
// 花瓶顺序：玻璃瓶和普通瓶各自按这台机器的种子洗牌，再交替排开，起点也错开
function vaseOrder(vs) {
  const deal = (arr, salt) => shuffled(arr, USER, salt);
  const gl = deal(vs.filter(k => KIT[k].glass), 7), ot = deal(vs.filter(k => !KIT[k].glass), 8), out = [];
  for (let i = 0; i < Math.max(gl.length, ot.length); i++) { if (gl[i]) out.push(gl[i]); if (ot[i]) out.push(ot[i]); }
  return out;
}
function weekRecipe(q, d, wk) {
  const qs = d.getFullYear() * 4 + Math.floor(d.getMonth() / 3);
  const deal = (arr, salt) => shuffled(arr, qs, USER, salt);
  const F = deal(q.focal, 1), focal = F[((wk % F.length) + F.length) % F.length];
  const Sp = deal(q.second, 2).filter(x => x !== focal), o = ((wk * 2) % Sp.length + Sp.length) % Sp.length;
  const at = (arr, i) => arr[((i % arr.length) + arr.length) % arr.length];
  return { name: q.name, focal: [focal], second: [at(Sp, o), at(Sp, o + 1)], line: [at(q.line, wk + USER)],
    fill: hq(qs, USER, wk, 3) < .55 ? [at(q.fill, wk + (USER >> 3)), 'gyps1'] : [at(q.fill, wk + (USER >> 3))], foliage: q.foliage };
}
const HOLI = {
  // 情人节这类是"设计过的"花束：同一种花、大小颜色几乎一致、排得圆满
  love: { focal: ['red'], second: [], line: [], fill: ['gyps1'], foliage: ['euca1', 'euca2'], uniform: true, style: 'dome', focalN: 21 },
  mother: { focal: ['carn'], second: ['champ'], line: [], fill: ['gyps1'], foliage: ['euca1', 'euca2'], style: 'dome' },
  teacher: { focal: ['lisi'], second: ['carn'], line: ['line_snap'], fill: ['fill_lace'], foliage: ['euca1'] },
  xmas: { focal: ['red'], second: ['champ'], line: ['line_willow'], fill: ['gyps1'], foliage: ['euca1', 'euca2'] },
  spring: { focal: ['red'], second: ['ranun', 'tulip'], line: ['line_willow'], fill: ['fill_spiraea'], foliage: ['euca1'], style: 'asym' },
  moon: { focal: ['champ'], second: ['pong', 'sun'], line: ['line_grass'], fill: ['fill_spray'], foliage: ['euca1'] },
};
// 农历：assets/lunar.json 来自香港天文台对照表（2025–2100），见 tools/build_lunar.py
let LUNAR = null;
function lunarOf(d) {
  if (!LUNAR) return null;
  const n = dayNo(d); let at = LUNAR.m0;
