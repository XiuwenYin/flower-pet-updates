    else {
      vaseImg();
      stems.forEach((s, j) => drawStem(s, lifes[j], t));
      // 开口里越往下越暗；再把瓶口前沿和瓶身盖上去，花茎就是从前沿后面插进去的
      // 开口里的暗影：中心偏下最暗，往边缘羽化到透明，不会出现一圈硬边
      g.save(); g.translate(V.cx, V.oy + V.ory * .25); g.scale(1, V.ory / V.orx);
      const gr = g.createRadialGradient(0, 0, 0, 0, 0, V.orx);
      gr.addColorStop(0, 'rgba(22,18,14,.62)'); gr.addColorStop(.6, 'rgba(22,18,14,.38)'); gr.addColorStop(1, 'rgba(22,18,14,0)');
      g.fillStyle = gr; g.beginPath(); g.arc(0, 0, V.orx, 0, 7); g.fill(); g.restore();
      g.save(); g.beginPath(); g.rect(0, V.oy, W, H); g.clip(); g.beginPath(); g.rect(0, V.oy, W, H); mouthPath(g); g.clip('evenodd'); vaseImg(); g.restore();
    }
    stems.forEach((s, j) => petals(s, lifes[j], t, 'front'));
    // 长按时的提示：按住的地方一圈淡淡的风纹慢慢合拢
    if (hold) {
      const k = clamp((performance.now() - hold.t) / HOLD_MS);
      g.save(); g.strokeStyle = theme === 'dark' ? `rgba(230,236,240,${.35 * k})` : `rgba(60,60,70,${.3 * k})`; g.lineWidth = 1.4 * S; g.lineCap = 'round';
      for (let i = 0; i < 3; i++) { g.beginPath(); g.arc(hold.x, hold.y, (16 + i * 7) * S, -Math.PI / 2 + i, -Math.PI / 2 + i + k * Math.PI * 1.4); g.stroke(); }
      g.restore();
