  camel: { name: '山茶', stem: 'camel', width: 100, tint: 'hue-rotate(-8deg) saturate(1.6)' },
  anem: { name: '银莲花', stem: 'anem', width: 92, tint: 'saturate(0) brightness(1.25)' },
  frees: { name: '小苍兰', stem: 'frees', width: 74, tint: 'hue-rotate(40deg) saturate(1.2) brightness(1.1)' },
  hyac: { name: '风信子', stem: 'hyac', width: 72, tint: 'hue-rotate(200deg) saturate(.9)', short: .62, stemW: .8 },   // 风信子茎短而粗：插得低，不硬拉长
  calla: { name: '马蹄莲', stem: 'calla', width: 84, tint: 'saturate(0) brightness(1.25)' },
  lily: { name: '百合', stem: 'lily', width: 122, tint: 'saturate(1.4)' },
