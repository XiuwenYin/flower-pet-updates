<title>瓶中花</title>
<style>
  :root { --ink:#2d2a26; --muted:#5f5850; --chip:rgba(255,255,255,.82); }
  body[data-t=dark] { --ink:#ebe6de; --muted:#a39d95; --chip:rgba(36,40,48,.85); }
  html,body { margin:0; height:100%; overflow:hidden; font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",system-ui,sans-serif; color:var(--ink) }
  body { background:radial-gradient(120% 90% at 20% 10%,#e4e2dc 0,#cfcbc2 45%,#a9a49a 100%) }
  body[data-t=dark] { background:radial-gradient(120% 90% at 20% 10%,#2a3242 0,#161b26 50%,#0b0e14 100%) }
  .win { position:absolute; background:#f6f5f2; border-radius:10px; box-shadow:0 18px 50px rgba(40,36,30,.22); overflow:hidden }
  .win .bar { height:26px; background:#e9e7e2 } .win .ln { height:9px; margin:16px 22px 0; background:#e0ddd6; border-radius:4px }
  body[data-t=dark] .win { background:#1d2129; box-shadow:0 18px 50px rgba(0,0,0,.5) }
  body[data-t=dark] .win .bar { background:#272b34 } body[data-t=dark] .win .ln { background:#323742 }
  .w1 { left:6%; top:12%; width:42%; height:50% } .w2 { left:30%; top:30%; width:26%; height:40% }
  #c { position:absolute; inset:0; width:100%; height:100%; pointer-events:none }
  .ctl { position:absolute; left:16px; top:14px; display:flex; gap:8px; flex-wrap:wrap; align-items:center; z-index:2; max-width:calc(100% - 32px) }
  .ctl button, .ctl input { font:13px inherit; font-family:inherit; color:var(--ink); background:var(--chip); border:0; border-radius:999px; padding:6px 14px; cursor:pointer; box-shadow:0 2px 8px rgba(20,30,50,.14) }
  .ctl input { padding:5px 12px; color-scheme:light dark }
  .ctl button.on { background:var(--ink); color:#fff } body[data-t=dark] .ctl button.on { color:#15171c }
  .ctl .sep { width:1px; height:18px; background:var(--muted); opacity:.4 }
  .cap { position:absolute; left:18px; bottom:16px; max-width:min(480px,56%); z-index:2 }
  /* 桌面程序里：透明背景，只剩花，按钮、说明、假窗口都不要 */
  body.desk { background:transparent !important } body.desk .win, body.desk .ctl, body.desk .cap { display:none }
  .cap b { font-size:15px; font-weight:600 } .cap p { margin:4px 0 0; font-size:12.5px; line-height:1.65; color:var(--muted) }
  /* 花笺：每天第一次见面时在花瓶旁边竖着放一张小纸条，写农历日子和一句应时的诗，过一会儿自己淡去 */
  .jian { position:absolute; z-index:3; writing-mode:vertical-rl; font-family:"Songti SC","STSong","Noto Serif SC","SimSun",serif; color:#3b342b;
    font-size:13px; background:#f3eee3; border:1px solid rgba(90,70,40,.16); border-radius:2px; box-shadow:0 .4em 1.3em rgba(20,16,10,.22);
    padding:.85em .55em; height:max-content; line-height:1.65; letter-spacing:.08em; opacity:0; transition:opacity 1.4s ease; pointer-events:none; cursor:default; user-select:none }
  .jian.on { opacity:1; pointer-events:auto }
  /* 英文花笺：横排，日期和节气一行，诗两行，作者和诗名靠右 */
  .jian.en { writing-mode:horizontal-tb; font-family:Georgia,"Iowan Old Style","Palatino Linotype",serif; letter-spacing:0; line-height:1.5; width:max-content; max-width:18em; padding:.8em 1em .75em }
  .jian.en .col.p { padding-left:1em; text-indent:-1em } .jian.en .g { margin:0 0 .45em } .jian.en .g + .g { margin-top:-.45em }
  .jian.en .a { margin-top:.5em; padding-top:0; text-align:right } .jian.en .a + .a { margin-top:0 } .jian.en i { font-style:italic; text-combine-upright:none }
  .jian .col { display:block } .jian i { font-style:normal; text-combine-upright:all }
  .jian .g, .jian .t, .jian .a { font-size:.8em; color:#8a7a62 } .jian .t { margin-left:.35em } .jian .a { margin-top:auto; padding-top:.8em; text-align:end } .jian .a.b { margin-left:-.25em }
  /* 横排卡片：首次打开的说明、新版本提示。样式与花笺一致 */
  .note { position:absolute; z-index:3; width:12em; box-sizing:border-box; font-family:"PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif; font-size:12px;
    color:#4a4237; background:#f3eee3; border:1px solid rgba(90,70,40,.16); border-radius:2px; box-shadow:0 .4em 1.3em rgba(20,16,10,.22);
    padding:1.15em 1.25em 1em; line-height:1.75; opacity:0; transition:opacity 1.2s ease; pointer-events:none; cursor:default; user-select:none }
  .note.on { opacity:1; pointer-events:auto }
  html[lang=en] .note { width:15em; font-family:system-ui,-apple-system,"Segoe UI",sans-serif; line-height:1.55 }
  html[lang=en] .note b { font-family:Georgia,"Times New Roman",serif; letter-spacing:0 } html[lang=en] .tip { font-family:system-ui,-apple-system,"Segoe UI",sans-serif }
  .note b { display:block; font-family:"Songti SC","STSong","Noto Serif SC","SimSun",serif; font-size:1.25em; font-weight:600; color:#3b342b; letter-spacing:.05em; margin-bottom:.4em }
  .note p { margin:0 0 .5em } .note .s { font-size:.92em; color:#6e6150; margin:0 }
  .note a { display:block; color:#9e3b2f; font-size:1.08em; padding:.3em 0 .15em; cursor:pointer; text-decoration:none } .note a:hover { color:#7a2c23 }
  .note a.q { color:#6e6150; font-size:1em; padding:.15em 0 0 } .note a.q:hover { color:#3b342b }
  /* 指针停在枯花上时的提示 */
  .tip { position:absolute; z-index:4; font-family:"PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif; font-size:12px; color:#3b342b; background:#f3eee3;
    border-radius:2px; padding:.45em .8em; box-shadow:0 .3em 1em rgba(10,12,16,.3); white-space:nowrap; opacity:0; transition:opacity .5s ease; pointer-events:none }
  .tip.on { opacity:1 }
  /* 出现慢、消失快 */
  .jian:not(.on), .note:not(.on), .tip:not(.on) { transition-duration:.25s }
</style>
