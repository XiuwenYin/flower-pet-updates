<script>
/* 瓶中花
   像真的买花一样：每周一插一束新花、换一只花瓶；这一周里每天开一点——头两天多是花苞，中间盛开，
   后几天开始谢，花瓣落在桌上，谢掉的那枝换一枝别的花补上。节日当天换成节日花束。
   一束花按花艺的分工来插：线条花定高度和轮廓，主花 3 或 5 枝压在中间偏低处，配花围着，填充花冒在主花上面，叶材打底。 */
const P = new URLSearchParams(location.search);
// 桌面程序（Electron 壳）里打开：?desk=1，壳通过 preload 提供 window.flowerDesk
const DESK = P.has('desk'), DK = window.flowerDesk;
if (DESK) document.body.classList.add('desk');
// 图片格式：桌面程序的内容包把 PNG 转成了 WebP（体积约 1/4）；网页原型里直接用 PNG 原图
const IMG = P.get('fmt') || (DESK ? 'webp' : 'png');
let theme = P.get('t') === 'light' ? 'light' : DESK && matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
const cv = document.getElementById('c'), mg = cv.getContext('2d');
// 整个场景先画到 scn 上，再带着调色（降对比、随钟点的冷暖）贴到屏幕上
// 桌面模式没有环境光那一层：直接画在窗口画布上，调色交给 CSS filter 由合成器做，每帧省掉一次整张带滤镜的复制
const scn = DESK ? cv : document.createElement('canvas'); let g = scn.getContext('2d');
const low = document.createElement('canvas'), lg = low.getContext('2d'); // 玻璃瓶里水下那段花茎单独画在这里
let W, H, S, DPR, seed0 = 1;

/* ── 工具 ── */
const fmix = h => { h ^= h >>> 16; h = Math.imul(h, 0x85ebca6b); h ^= h >>> 13; h = Math.imul(h, 0xc2b2ae35); return h ^ (h >>> 16); };
// 稳定的随机数：同样的参数每次算出来都一样，不用存状态
function hash(...k) { let h = fmix((seed0 | 0) + 0x9e3779b9); for (const v of k) h = fmix(h ^ (Math.imul(v | 0, 0x9e3779b1) + 0x7f4a7c15 + (h << 6) + (h >>> 2))); return (h >>> 0) / 4294967296; }
const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
const lerp = (a, b, t) => a + (b - a) * t;
const ss = (a, b, x) => { const t = clamp((x - a) / (b - a)); return t * t * (3 - 2 * t); };
const pick = (arr, r) => arr[Math.floor(r * arr.length) % arr.length];

/* ── 花材 ──
   开花的花：六张阶段图（青苞、转色、初开、盛开、半谢、残花），有的还有侧脸（side3 初开、side4 盛开）。
   width：盛开时在屏幕上的宽度；tint：落在桌上的花瓣调色（花瓣素材是一套粉色玫瑰瓣） */
const SPECIES = {
  rose: { name: '玫瑰', stem: 'rose', width: 112, tint: '' },
  red: { name: '红玫瑰', stem: 'rose', width: 112, tint: 'hue-rotate(-12deg) saturate(3.2) brightness(.62)' },
