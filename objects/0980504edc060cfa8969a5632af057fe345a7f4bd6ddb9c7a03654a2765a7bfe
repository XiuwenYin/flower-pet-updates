  if (id) nameTimer = setTimeout(() => { nameTip.textContent = w.text; placeName(x, y); nameTip.classList.add('on'); }, NAME_MS);
}
addEventListener('pointermove', e => nameHover(e.clientX, e.clientY));
addEventListener('pointerleave', () => nameHover(-1e4, -1e4));
DK?.onCursor?.((x, y) => nameHover(x, y));
let deskHit = false;
// 设置面板开着时，在花的窗口里按下鼠标就关掉它；面板里点"显示今日花笺"时再出一次花笺，照常停留一会儿后淡去
if (DK?.panelOff) addEventListener('pointerdown', () => DK.panelOff(), true);
DK?.onShowJian?.(() => { hideNote(); showJian(day, true); });
// 面板里点"不再用这只花瓶"：记下来，这一周马上换一只；点"恢复隐藏的花瓶"清空
DK?.onNoVase?.(k => {
  try { const no = k ? [...new Set([...noVase(), k])] : []; localStorage.setItem('flowerNoVase', JSON.stringify(no)); } catch (e) { }
  setDay(day);
});
// 指针下有花（或花瓣、花笺）时窗口接住鼠标，否则让鼠标穿过去。指针位置来自页面收到的鼠标移动，
// 0.4.4 起壳也会自己读指针位置发过来（Mac 桌面层窗口收不到转发的鼠标移动）
function deskHover(x, y) { const h = !!hold || dragging || onTable(x, y) || !!wiltedAt(x, y) || onJian(x, y) || vaseMenu(x, y); if (h !== deskHit) { deskHit = h; DK.setInteractive(h); } }
if (DK) addEventListener('pointermove', e => deskHover(e.clientX, e.clientY));
DK?.onCursor?.((x, y) => deskHover(x, y));
applyTheme();
// 过了午夜换成新一天（新的一周就换新花束）
// 原来只在午夜那一分钟里检查，电脑睡过了午夜，醒来还停在昨天；现在只要"正在显示的是当天"就跟着日历走
let liveDay = null;
function checkNewDay() {
  const n = new Date();
  if (!liveDay || weekPlay || P.get('date') || iso(day) !== liveDay || iso(n) === liveDay) return;
  liveDay = iso(n);
  setDay(new Date(n.getFullYear(), n.getMonth(), n.getDate())).then(() => DESK && setTimeout(() => showJian(day), 1500));
}
setInterval(checkNewDay, 60e3);
(async () => {
  [KIT, LUNAR, POEMS] = await Promise.all([fetch('assets/kit/meta.json').then(r => r.json()), fetch('assets/lunar.json').then(r => r.json()).catch(() => null), fetch(EN ? 'assets/poems_en.json' : 'assets/poems.json').then(r => r.json()).catch(() => null)]);
  if (EN) { POEMS_EN = POEMS; POEMS = null; }
  const now = new Date();
  await setDay(P.get('date') ? parse(P.get('date')) : new Date(now.getFullYear(), now.getMonth(), now.getDate()));
  if (P.has('week')) weekBtn.onclick();
  if (!P.get('date')) liveDay = iso(day);
  let introSeen = true; try { introSeen = !!localStorage.getItem('flowerIntro'); } catch (e) { }
  if (DESK && (!introSeen || P.has('intro')) && !P.has('jian')) setTimeout(showIntro, 1500);
  else if (DESK || P.has('jian')) setTimeout(() => showJian(day, P.has('jian')), 1500);
  DK?.ready();   // 告诉壳这版内容能正常跑（更新后用来判断要不要回滚）
})().catch(e => console.error('加载失败', e));
requestAnimationFrame(frame);
</script>
