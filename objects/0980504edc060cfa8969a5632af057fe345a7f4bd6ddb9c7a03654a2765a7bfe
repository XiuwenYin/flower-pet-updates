  bird: { name: '鹤望兰', stem: 'bird', width: 104, tint: 'hue-rotate(20deg) saturate(2.5)' },
  // 彩蛋·稀有花色：这一周轮到玫瑰、郁金香、绣球时，偶尔有一枝是少见的颜色（RARE）
  rose_blue: { name: '蓝玫瑰', stem: 'rose', width: 112, tint: 'hue-rotate(185deg) saturate(1.4)' },
  tulip_black: { name: '黑郁金香', stem: 'tulip', width: 80, tint: 'hue-rotate(-40deg) saturate(1.2) brightness(.45)' },
  hydr_green: { name: '绿绣球', stem: 'hydr', width: 130, tint: 'hue-rotate(-160deg) saturate(.8)' },
  // 彩蛋·不是活的花（STILL）：金、水晶、不锈钢、玻璃、纸币折的，不会开也不会谢，只有一张图；花茎按 stemTint 调色
  still_gold: { name: '纯金玫瑰', stem: 'rose', width: 104, still: true, stemTint: 'sepia(1) saturate(1.5) hue-rotate(-12deg) brightness(.9)' },
  still_crystal: { name: '水晶玫瑰', stem: 'rose', width: 104, still: true, stemTint: 'grayscale(1) brightness(1.45) contrast(.8)' },
  still_steel: { name: '不锈钢郁金香', stem: 'tulip', width: 80, still: true, stemTint: 'grayscale(1) brightness(1.15) contrast(1.1)' },
  still_glass: { name: '玻璃百合', stem: 'lily', width: 116, still: true, stemTint: 'saturate(.7) brightness(1.15)' },
  still_cny: { name: '人民币折的玫瑰', stem: 'rose', width: 104, still: true },
  still_usd: { name: '美元折的玫瑰', stem: 'rose', width: 104, still: true },
  still_aud: { name: '澳元折的玫瑰', stem: 'rose', width: 104, still: true },
};
const RARE = { rose: 'rose_blue', tulip: 'tulip_black', hydr: 'hydr_green' };
// 纸币花：中文系统多出人民币，所在地是澳洲多出澳元，其余美元
const STILLS = () => ['still_gold', 'still_crystal', 'still_steel', 'still_glass', ZH ? 'still_cny' : 'still_usd', /^Australia\//.test(Intl.DateTimeFormat().resolvedOptions().timeZone || '') ? 'still_aud' : 'still_usd'];
// 不开花的枝：线条花、填充花、叶材（整枝一张图，根部是锚点）
const SPRAYS = {
  line_wint: '腊梅', line_sakura: '樱花', line_lotus: '莲蓬', line_kpaw: '袋鼠爪', fill_osman: '桂花', fill_lilac: '丁香',
  leaf_olive: '橄榄枝', leaf_fern: '蕨叶', leaf_monst: '龟背竹叶', leaf_dusty: '银叶菊', leaf_nandina: '南天竹',
  line_willow: '银柳', line_snap: '金鱼草', line_jacar: '蓝花楹', line_jacar_w: '白色蓝花楹', line_delph: '飞燕草', line_grass: '狼尾草',
  fill_spiraea: '小手球', fill_lace: '蕾丝花', fill_chamo: '洋甘菊', fill_spray: '多头小菊', gyps1: '满天星',
  euca1: '尤加利', euca2: '尤加利',
};
// 个别枝材的长度、宽度上限系数：蓝花楹是一大串圆锥花序，比金鱼草、飞燕草宽一倍，按线条花的宽度上限会被压得很小、缩在叶子后面
const SPRAY_FIT = { line_jacar: { L: 1.3, w: 2 }, line_jacar_w: { L: 1.3, w: 2 } };
// 花瓶按周轮换，材质交错排开
// 换瓶顺序：玻璃瓶和普通瓶一周一换、交替着来（藤编篮装不了水，不用）
const VASES = { vase_glass: '透明玻璃瓶', vase_d: '青花瓶', vase_crystal: '切面水晶瓶', vase_enamel: '搪瓷水壶', vase_pink: '淡粉玻璃瓶',
  vase_c: '粗陶罐', vase_cyl: '直筒玻璃杯', vase_brass: '黄铜壶', vase_jar: '玻璃储物罐', vase: '青瓷瓶', vase_bubble: '气泡玻璃瓶',
  vase_f: '琥珀釉瓶', vase_trumpet: '喇叭口玻璃瓶', vase_bamboo: '竹筒', vase_green: '绿玻璃瓶',
  vase_ru: '汝窑天青瓶', vase_white: '白瓷细颈瓶', vase_black: '黑陶罐', vase_wood: '柴烧杯', vase_pewter: '锡壶',
