  sun: { name: '向日葵', stem: 'sun', width: 118, tint: 'hue-rotate(45deg) saturate(3.5)' },
  hydr: { name: '绣球', stem: 'hydr', width: 130, tint: 'hue-rotate(-95deg) saturate(1.4)' },
